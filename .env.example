# Copy to .env.local for local development, and add the same variable in Vercel.
NEXT_PUBLIC_SITE_URL=https://www.theaccuweather.com

# Phase 3 (rankings history). Both are optional: without them the site uses live API calls.
# DATABASE_URL is added for you when you connect a Neon database in Vercel's Storage tab.
DATABASE_URL=
# Any long random string (Terminal: openssl rand -hex 32). Add it in Vercel AND in GitHub secrets.
CRON_SECRET=
